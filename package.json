{
  "name": "moveinsync-playstore-analysis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:dashboard",
    "fetch:reviews": "node scripts/fetch_playstore_reviews.mjs",
    "build:gold-sample": "node scripts/build_gold_sample.mjs",
    "classify:reviews": "node scripts/classify_reviews.mjs",
    "classify:llm": "python3 scripts/classify_reviews_llm.py",
    "evaluate:llm": "python3 scripts/evaluate_llm_classifier.py",
    "review:llm": "python3 scripts/review_llm_predictions.py",
    "test:llm": "python3 -m unittest discover -s tests -p 'test_*llm*.py'",
    "evaluate:classifier": "node scripts/evaluate_classifier.mjs",
    "evaluate:holdout": "node scripts/evaluate_classifier.mjs analysis/holdout_labels.json analysis/holdout_evaluation.json",
    "evaluate:final": "node scripts/evaluate_classifier.mjs analysis/final_validation_labels.json analysis/final_validation_evaluation.json",
    "evaluate:frozen": "node scripts/evaluate_classifier.mjs analysis/frozen_validation_labels.json analysis/frozen_validation_evaluation.json",
    "build:manual-analysis": "node scripts/build_manual_analysis.mjs",
    "analyze:reviews": "node scripts/analyze_reviews.mjs",
    "record:rating-snapshot": "node scripts/record_rating_snapshot.mjs",
    "validate:refresh": "node scripts/validate_refresh.mjs",
    "refresh:data": "npm run fetch:reviews && npm run record:rating-snapshot && npm run analyze:reviews && npm run validate:refresh && npm run build:dashboard",
    "build:dashboard": "node scripts/build_bento_dashboard.mjs",
    "build:pdf": "python3 scripts/build_submission_pdf.py"
  },
  "dependencies": {
    "chart.js": "4.4.7",
    "google-play-scraper": "10.1.3"
  }
}
